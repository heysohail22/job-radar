# One environment configuration for API + discovery. Never commit backend/.env.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
JOB_RADAR_PROFILE_VERSION=skills-v2
# Local personal use. Public hosting: AUTH_MODE=owner, HOST=0.0.0.0, OWNER_USER_ID=<existing owner UUID>.
AUTH_MODE=local
OWNER_USER_ID=
HOST=127.0.0.1
PORT=3001
WEBSITE_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Turn on after keys/preview are verified and the old timer is disabled.
COLLECTOR_ENABLED=false
COLLECTOR_WRITE=true
COLLECTOR_TIMEZONE=Asia/Kolkata
COLLECTOR_HOUR=9
COLLECTOR_MINUTE=0
OLD_COLLECTOR_DISABLED=false
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
FIRECRAWL_API_KEY=
TAVILY_DAILY_LIMIT=20
TAVILY_MONTHLY_LIMIT=900
FIRECRAWL_DAILY_LIMIT=20
FIRECRAWL_MONTHLY_LIMIT=900
MAX_QUERIES=20
MAX_CANDIDATES=100

# Optional Chromium rendering before Firecrawl. Install the pinned browser first.
ENABLE_BROWSER=false
