{
  "name": "@job-radar/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@job-radar/contracts": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "fastify": "5.12.7",
    "@fastify/rate-limit": "11.2.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "owner:setup": "node --env-file=.env --import tsx scripts/setup-owner.ts",
    "backup": "node --env-file=.env --import tsx scripts/backup.ts"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/node": "26.6.5"
  }
}
