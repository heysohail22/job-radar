# ========================================================
# Agentic AI Resume Workspace - Environment Configuration
# ========================================================
# Copy this file to '.env' and insert your API keys below.

# 1. Groq API Key (Get free key at: https://console.groq.com/keys)
# Powers models: openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3.6-27b
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
# Powers models: gemini-2.5-flash, gemini-3.5-flash-lite
VITE_GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# 3. Firecrawl API Key (Get free key at: https://www.firecrawl.dev)
# Powers dynamic YC & AI career page crawling
VITE_FIRECRAWL_API_KEY=fc_your_firecrawl_api_key_here

