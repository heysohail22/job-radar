{
  "name": "@job-radar/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@job-radar/contracts": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "@langchain/langgraph": "1.5.1",
    "@langchain/core": "1.2.18",
    "@langchain/groq": "1.3.1",
    "@langchain/google-genai": "2.3.2",
    "cheerio": "1.2.0",
    "undici": "8.12.2",
    "robots-parser": "3.0.1",
    "zod": "4.6.7",
    "playwright": "1.64.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "preview": "node --env-file-if-exists=.env --import tsx src/cli.ts --preview",
    "collect": "node --env-file-if-exists=.env --import tsx src/cli.ts --write",
    "schedule:install": "node --env-file=.env --import tsx scripts/install-schedule.ts"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/node": "26.6.5"
  }
}
